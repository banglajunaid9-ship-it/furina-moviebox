# Copy to .env.local. Never commit real values.
# Only VITE_* variables reach the client bundle — they must be PUBLIC values.

# Supabase project (public anon key is safe for the client; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI assistant: leave empty to use the Supabase edge function at
# <VITE_SUPABASE_URL>/functions/v1/ai-assistant. Users may also set a keyless
# local endpoint (e.g. Ollama) in Settings → AI.
VITE_AI_ENDPOINT=

# ---- Server-side only (Supabase secrets, NOT VITE_) ----
# supabase secrets set AI_PROVIDER=anthropic ANTHROPIC_API_KEY=... AI_MODEL=claude-sonnet-5-5
# supabase secrets set AI_PROVIDER=openai OPENAI_API_KEY=... OPENAI_BASE_URL=https://api.openai.com/v1 AI_MODEL=...
# supabase secrets set AI_DAILY_LIMIT=50
